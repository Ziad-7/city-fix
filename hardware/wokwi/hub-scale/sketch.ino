#include <Arduino.h>
#include <HX711.h>
#include <Preferences.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include "core.h"

using namespace citycycle_scale;
constexpr int HX_DT=32,HX_SCK=33,TARE_BTN=25,CONFIRM_BTN=26,NET_SW=27,LED_STATUS=19;
constexpr uint16_t MAGIC=0xC531,VERSION=1;
HX711 scale; Preferences prefs; Adafruit_SSD1306 display(128,64,&Wire,-1);
struct Persisted {uint16_t magic=MAGIC,version=VERSION;Queue queue{};float offset=0,countsPerKg=420;bool tared=false,calibrated=false;uint32_t mockLastAccepted=0,crc=0;};
Persisted saved; bool storageUsable=false,netOn=true,netOverride=false,available=false,failNext=false; char material[24]="pet_plastic",pickup[40]="";
String line; uint8_t failures=0; uint32_t nextRetry=0; bool previousNet=true;
uint32_t savedCrc(const Persisted&p){return crc32(&p,sizeof(Persisted)-sizeof(p.crc));}
bool saveState(){saved.crc=savedCrc(saved);return prefs.putBytes("state",&saved,sizeof(saved))==sizeof(saved);}
void loadState(){bool began=prefs.begin("hubscale",false);bool exists=began&&prefs.isKey("state");Persisted p{};size_t actual=exists?prefs.getBytesLength("state"):0;size_t read=exists&&actual==sizeof(p)?prefs.getBytes("state",&p,sizeof(p)):0;bool valid=p.magic==MAGIC&&p.version==VERSION&&p.crc==savedCrc(p)&&p.queue.count<=QueueCapacity&&p.queue.nextSeq>0&&validCalibration(1,p.countsPerKg);LoadDisposition disposition=classifyPersistentLoad(began,exists,actual,sizeof(p),read,valid);if(disposition==LoadDisposition::RestoreExisting){saved=p;storageUsable=true;return;}if(disposition==LoadDisposition::InitializeMissing){saved=Persisted{};storageUsable=saveState();if(!storageUsable)Serial.println(F("NVS ERROR: initial state not saved; confirmation/delivery disabled"));return;}storageUsable=false;Serial.println(F("NVS ERROR: existing state unreadable/invalid or storage unavailable; preserving record and disabling confirmation/delivery"));}
bool waitReady(uint32_t timeout=150){uint32_t start=millis();while(!scale.is_ready()&&millis()-start<timeout)delay(2);return scale.is_ready();}
bool readAverageBounded(uint8_t n,float &average){if(!available||n==0)return false;double sum=0;for(uint8_t i=0;i<n;i++){if(!waitReady(150))return false;sum+=scale.read();}average=static_cast<float>(sum/n);return std::isfinite(average);}
bool stableRead(float &kg){if(!available||!saved.tared||!saved.calibrated)return false;float samples[5];for(int i=0;i<5;i++){float raw;if(!readAverageBounded(1,raw))return false;samples[i]=(raw-saved.offset)/saved.countsPerKg;}return stableWeight(samples,5,kg);}
void render(const char* state,float kg=NAN){digitalWrite(LED_STATUS,netOn?HIGH:LOW);display.clearDisplay();display.setTextColor(SSD1306_WHITE);display.setTextSize(1);display.setCursor(0,0);display.println(F("CITYCYCLE HUB SIM"));display.print(F("Weight: "));if(std::isfinite(kg)){display.print(kg,2);display.println(F(" kg"));}else display.println(F("-- kg"));display.print(F("Tare "));display.print(saved.tared?F("OK"):F("NEEDED"));display.print(F(" Cal "));display.println(saved.calibrated?F("SIM"):F("NEEDED"));display.print(F("Material: "));display.println(material);display.print(F("Net "));display.print(netOn?F("ON"):F("OFF"));display.print(F(" Q:"));display.println(saved.queue.count);display.println(F("LOCAL MOCK / NO HTTP"));display.println(storageUsable?state:"NVS ERROR - disabled");display.display();Serial.print(F("SIMULATOR | "));Serial.print(storageUsable?state:"NVS ERROR - disabled");Serial.print(F(" kg="));if(std::isfinite(kg))Serial.print(kg,3);else Serial.print(F("UNAVAILABLE"));Serial.print(F(" tare="));Serial.print(saved.tared?F("yes"):F("no"));Serial.print(F(" calibration="));Serial.print(saved.calibrated?F("simulated"):F("needed"));Serial.print(F(" material="));Serial.print(material);Serial.print(F(" network="));Serial.print(netOn?F("ON"):F("OFF"));Serial.print(F(" pending="));Serial.println(saved.queue.count);}
void printQueue(){Serial.println(F("OUTBOX (proposed only; local mock ACK is not backend delivery):"));for(uint8_t i=0;i<saved.queue.count;i++){const Weighing&w=saved.queue.rows[i];Serial.printf("{\"seq\":%lu,\"at\":null,\"material\":\"%s\",\"kg\":%.3f",(unsigned long)w.seq,w.material,w.kg);if(w.pickup[0])Serial.printf(",\"pickupId\":\"%s\"",w.pickup);Serial.println("}");}}
bool confirmWeight(){if(!storageUsable){Serial.println(F("NVS unavailable: confirmation disabled"));render("NVS ERROR");return false;}float kg;if(!stableRead(kg)){Serial.println(F("WEIGHT UNAVAILABLE/UNSTABLE: no weighing queued"));render("HX711 FAULT / UNSTABLE");return false;}Persisted before=saved;if(!saved.queue.append(kg,material,pickup)){Serial.println(F("QUEUE FULL: weighing rejected; sequence unchanged"));render("QUEUE FULL",kg);return false;}if(!saveState()){saved=before;Serial.println(F("NVS ERROR: weighing rolled back"));return false;}printQueue();render("QUEUED",kg);return true;}
void deliver(bool explicitRequest=false){if(!storageUsable){Serial.println(F("NVS unavailable: delivery disabled"));return;}if(!saved.queue.count)return;if(!netOn){Serial.println(F("NETWORK OFF: queue retained"));render("OFFLINE QUEUED");return;}if(!explicitRequest&&static_cast<int32_t>(millis()-nextRetry)<0)return;Serial.println(F("LOCAL MOCK RECEIVER (no HTTP): confirming weighing"));const Weighing&w=saved.queue.rows[0];Persisted before=saved;if(w.seq<=saved.mockLastAccepted)Serial.println(F("LOCAL MOCK DUPLICATE: already accepted; returning ACK"));else{saved.mockLastAccepted=w.seq;if(!saveState()){saved=before;Serial.println(F("LOCAL MOCK receiver state not saved; queue retained"));return;}}if(failNext){failNext=false;failures=failures<5?failures+1:5;nextRetry=millis()+(1000UL<<((failures-1)>4?4:(failures-1)));Serial.println(F("LOCAL MOCK RESPONSE LOST AFTER COMMIT; exact queue row retained"));render("MOCK RETRY");return;}Serial.printf("MOCK ACK {accepted:[%lu]} — NOT BACKEND DELIVERY\n",(unsigned long)w.seq);saved.queue.acknowledgeOldest();if(!saveState()){saved=before;Serial.println(F("NVS ACK save failed; weighing restored"));return;}failures=0;nextRetry=millis();render("LOCAL MOCK ACK");}
void doTare(){if(!storageUsable){Serial.println(F("NVS unavailable: tare disabled"));return;}float raw;if(!readAverageBounded(10,raw)){Serial.println(F("HX711 unavailable or tare timed out; tare not changed"));return;}Persisted before=saved;saved.offset=raw;saved.tared=true;if(!saveState()){saved=before;Serial.println(F("NVS tare save failed"));return;}scale.set_offset((long)raw);Serial.println(F("TARE SAVED (platform must be unloaded)"));render("TARED");}
bool calibrate(float knownKg){if(!storageUsable){Serial.println(F("NVS unavailable: calibration disabled"));return false;}if(!validCalibration(knownKg,1)||!available||!saved.tared){Serial.println(F("Calibration rejected: use positive finite known kg, available/tared scale"));return false;}float raw;if(!readAverageBounded(10,raw)){Serial.println(F("Calibration timed out; unchanged"));return false;}raw-=saved.offset;if(!validCalibration(knownKg,raw)){Serial.println(F("Calibration samples invalid"));return false;}Persisted before=saved;saved.countsPerKg=raw/knownKg;saved.calibrated=true;if(!saveState()){saved=before;Serial.println(F("NVS calibration save failed"));return false;}scale.set_scale(saved.countsPerKg);Serial.printf("SIMULATED CALIBRATION SAVED: %.2f counts/kg; no accuracy claim\n",saved.countsPerKg);render("CALIBRATED");return true;}
void help(){Serial.println(F("Commands: help | status | tare | calibrate <known-kg> | material <pet_plastic|paper_cardboard|metal_cans|glass|e_waste|cooking_oil|organics> | pickup <id>|pickup clear | network on|off|auto | confirm | send | mock fail-next"));}
void command(String s){s.trim();String low=s;low.toLowerCase();if(low=="help"){help();return;}if(low=="status"){float kg=NAN;stableRead(kg);render("STATUS",kg);printQueue();return;}if(low=="tare"){doTare();return;}if(low=="confirm"){if(confirmWeight())deliver(true);return;}if(low=="send"){deliver(true);return;}if(low=="network auto"){netOverride=false;return;}if(low=="network on"||low=="network off"){netOverride=true;netOn=low.endsWith("on");render("NETWORK OVERRIDE");if(netOn)deliver(true);return;}if(low=="mock fail-next"){failNext=true;Serial.println(F("next local mock ACK will be withheld"));return;}if(low.startsWith("calibrate ")){calibrate(s.substring(10).toFloat());return;}if(low.startsWith("material ")){String v=s.substring(9);v.trim();if(!validMaterialId(v.c_str())){Serial.println(F("invalid MaterialId; use one of the listed values"));return;}v.toCharArray(material,sizeof(material));render("MATERIAL SET");return;}if(low=="pickup clear"){pickup[0]=0;return;}if(low.startsWith("pickup ")){String v=s.substring(7);v.trim();if(v.length()>=sizeof(pickup)||v.indexOf('"')>=0||v.indexOf('\\')>=0){Serial.println(F("invalid pickupId"));return;}v.toCharArray(pickup,sizeof(pickup));return;}Serial.println(F("unknown command; type help"));}
void setup(){Serial.begin(115200);pinMode(TARE_BTN,INPUT_PULLUP);pinMode(CONFIRM_BTN,INPUT_PULLUP);pinMode(NET_SW,INPUT_PULLUP);pinMode(LED_STATUS,OUTPUT);Wire.begin(21,22);display.begin(SSD1306_SWITCHCAPVCC,0x3C);loadState();scale.begin(HX_DT,HX_SCK);available=waitReady(1500);if(available){scale.set_offset((long)saved.offset);scale.set_scale(saved.countsPerKg);}else Serial.println(F("HX711 unavailable; no fake zero weight"));help();Serial.println(F("SIMULATOR | HX711 50kg model starts at 420 counts/kg | local serial mock only"));render("STARTUP");}
void loop(){if(!netOverride)netOn=digitalRead(NET_SW)==HIGH;static bool oldT=true,oldC=true;bool t=digitalRead(TARE_BTN),c=digitalRead(CONFIRM_BTN);static uint32_t lastT=0,lastC=0;if(oldT&&!t&&millis()-lastT>60){lastT=millis();doTare();}if(oldC&&!c&&millis()-lastC>60){lastC=millis();if(confirmWeight())deliver(true);}oldT=t;oldC=c;while(Serial.available()){char c=Serial.read();if(c=='\n'||c=='\r'){if(line.length()){command(line);line="";}}else if(line.length()<160)line+=c;}if(!previousNet&&netOn&&saved.queue.count)deliver(true);previousNet=netOn;if(saved.queue.count&&netOn&&static_cast<int32_t>(millis()-nextRetry)>=0)deliver();static uint32_t lastRender=0;if(millis()-lastRender>1000){float kg=NAN;stableRead(kg);render("IDLE / CONFIRM TO WEIGH",kg);lastRender=millis();}delay(10);}
