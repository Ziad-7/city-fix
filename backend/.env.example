# Database configuration
DATABASE_URL=sqlite:///./fixthecity.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/fixthecity

# JWT secret key (change in production)
JWT_SECRET=your-super-secret-key-change-in-production

# OTP mode: demo (always returns 123456) or real (sends SMS/WhatsApp)
OTP_MODE=demo

# Seed database on startup if empty
SEED_ON_START=true

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# CORS origin regex pattern (for matching localhost with any port)
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1)(:\d+)?$

# API version
VERSION=0.1.0
