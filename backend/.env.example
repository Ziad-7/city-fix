# Database configuration
DATABASE_URL=sqlite:///./fixthecity.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/fixthecity

# JWT secret key (change in production)
JWT_SECRET=your-super-secret-key-change-in-production

# OTP mode: demo preserves the fixed local code; twilio uses server-side Verify bindings below.
OTP_MODE=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Local-only SQLite convenience. Production startup never creates schema or seeds data.
LOCAL_SCHEMA_BOOTSTRAP=false
SEED_ON_START=false

# Optional server-only Expo API credential. This is not a device push token.
EXPO_TOKEN=
PUSH_ENABLED=false

# Destructive /admin/demo/reset endpoint. Enable only for local demo environments.
DEMO_RESET_ENABLED=false

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# CORS origin regex pattern (for matching localhost with any port)
CORS_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1)(:\d+)?$

# API version
VERSION=0.1.0

# CityBrain hosted model credentials are server-only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Keep photo inference off until MediaStorage.read_approved checks consent and returns a safe derivative.
GEMINI_PHOTO_ANALYSIS_ENABLED=false

# Private Supabase Storage (create this bucket as private before enabling uploads).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=report-media

# Without Supabase Storage /uploads/sign hands out a stub URL that DISCARDS the file.
# Unset: allowed only with SQLite (local dev); any other database answers 503. true/false forces it.
# ALLOW_LOCAL_UPLOAD_STUB=true
