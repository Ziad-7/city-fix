{
  "expo": {
    "name": "CityFix",
    "slug": "fixthecity",
    "scheme": "fixthecity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F6F2",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fixthecity.mobile"
    },
    "android": {
      "package": "com.fixthecity.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#C8102E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#C8102E"
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "supportedLocales": [
            "ar",
            "en"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "التطبيق محتاج يوصل لصورك عشان تضيف صورة للبلاغ.",
          "cameraPermission": "التطبيق محتاج الكاميرا عشان تصوّر المشكلة وتبعتها مع البلاغ.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "التطبيق محتاج موقعك عشان نحدد مكان المشكلة على الخريطة."
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager (pulled in by react-native-maps) starts at launch and Room creates its database\n# by reflection. Without these rules R8 strips WorkDatabase_Impl and the app crashes on open.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.impl.WorkDatabase_Impl { *; }\n-keep class androidx.work.** { *; }\n-dontwarn androidx.work.**"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "التطبيق محتاج الميكروفون عشان تسجّل وصف المشكلة بصوتك."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#C8102E"
        }
      ]
    ]
  }
}
