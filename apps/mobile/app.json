{
  "expo": {
    "name": "FixTheCity",
    "slug": "fixthecity",
    "scheme": "fixthecity",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F6F2",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fixthecity.mobile"
    },
    "android": {
      "package": "com.fixthecity.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#C8102E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#C8102E"
        }
      ],
      [
        "expo-localization",
        { "forcesRTL": true, "supportedLocales": ["ar", "en"] }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "التطبيق محتاج يوصل لصورك عشان تضيف صورة للبلاغ.",
          "cameraPermission": "التطبيق محتاج الكاميرا عشان تصوّر المشكلة وتبعتها مع البلاغ.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "التطبيق محتاج موقعك عشان نحدد مكان المشكلة على الخريطة."
        }
      ]
    ]
  }
}
